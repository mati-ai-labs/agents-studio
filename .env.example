DATABASE_URL=postgres://paperclip:paperclip@localhost:5432/paperclip
PORT=3100
SERVE_UI=false
BETTER_AUTH_SECRET=paperclip-dev-secret
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=paperclip-dev-tool-action-signing-secret-change-me

# Optional: used for Google connector OAuth refresh + Claude MCP injection
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_WORKSPACE_MCP_URL=http://localhost:8000/mcp
# PAPERCLIP_MIRROR_RUN_LOGS=true

# Optional: used for Meta Ads connector OAuth refresh + Claude MCP injection
# META_ADS_APP_ID=
# META_ADS_APP_SECRET=
# META_ADS_MCP_URL=https://mcp.facebook.com/ads

# Optional: used for Slack connector OAuth
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=

# Discord webhook for daily merge digest (scripts/discord-daily-digest.sh)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# SearchFund dashboard (/searchfund)
# Shared secret the Apps Scripts send to POST /api/companies/:companyId/searchfund/ingest
SEARCHFUND_INGEST_TOKEN=
# Routine started by the dashboard's Qualify button (defaults to the routine titled "...Full Qualification...")
SEARCHFUND_ROUTINE_ID=
# Comma-separated emails allowed to see the dashboard; empty = every company member (instance admins always can)
SEARCHFUND_ALLOWED_EMAILS=
