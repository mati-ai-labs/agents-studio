{
  "name": "gmeet-notes",
  "version": "0.1.0",
  "description": "Capture, correlate, and query Google Meet 'Take notes with Gemini' Smart Notes from the CLI. Zero runtime dependencies.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "gmeet-notes": "dist/src/index.js"
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "selftest": "npm run build && node dist/src/index.js selftest",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "google-meet",
    "gemini",
    "smart-notes",
    "meeting-notes",
    "google-workspace",
    "cli"
  ],
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.7.3"
  }
}
